##############################################################################
# Frontend configuration — copy to frontend/.env and adjust.
#
#   cp frontend/.env.example frontend/.env
#
# Create React App only exposes variables prefixed with REACT_APP_, and it
# inlines them into the JavaScript bundle at BUILD time. Anything here is
# public: never put a secret or a private API key in this file.
##############################################################################

# --- Required: backend location ----------------------------------------------
# No trailing slash — the code appends paths like /api/payments/checkout/session.
# Local:      http://localhost:8001
# Docker:     http://localhost:8001
# Production: https://api.milenapetrova.bg
REACT_APP_BACKEND_URL=http://localhost:8001

# --- Optional: canonical site origin -----------------------------------------
# Used for canonical links and og:url. No trailing slash.
# Defaults to https://milenapetrova.bg (see src/config/site.js).
REACT_APP_SITE_URL=https://milenapetrova.bg

# --- Optional: media hosting -------------------------------------------------
# Base URL for the portrait images and the workbook PDF. These files currently
# still live on Emergent's customer-asset CDN and will 404 if that project is
# torn down — rehost them and point this at the new location.
# REACT_APP_ASSET_BASE_URL=https://cdn.milenapetrova.bg/assets

# --- Optional: dev server health endpoints -----------------------------------
# Set to "true" to enable the webpack health-check plugin in frontend/plugins.
ENABLE_HEALTH_CHECK=false
