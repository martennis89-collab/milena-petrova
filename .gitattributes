# Line-ending policy.
#
# This repository is developed on Windows and runs inside Linux containers. Git
# on Windows defaults to core.autocrlf=true, which rewrites checked-out text
# files to CRLF. For anything a Linux shell or Docker interprets, that is not
# cosmetic: a shell script with CRLF endings fails as
# "bad interpreter: /usr/bin/env bash^M", and the failure is unreadable.
#
# So: normalise text in the repository, and pin LF for everything Linux runs.

* text=auto eol=lf

# --- Must be LF, no exceptions -----------------------------------------------
*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf
Makefile        text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.env.example    text eol=lf

# --- Windows-native tooling keeps CRLF ---------------------------------------
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# --- Binary: never touch, never diff -----------------------------------------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.JPG    binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.mp4    binary
*.zip    binary

# --- Generated: collapse in diffs and reviews --------------------------------
yarn.lock         -diff linguist-generated
package-lock.json -diff linguist-generated
