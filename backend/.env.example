##############################################################################
# Backend configuration — copy to backend/.env and fill in real values.
#
#   cp backend/.env.example backend/.env
#
# .env is gitignored. Never commit real keys. Every value below is a
# placeholder; none of them work as written.
##############################################################################

# --- Required: database ------------------------------------------------------
# The app refuses to start without these two.
# Local:  mongodb://localhost:27017
# Docker: mongodb://mongo:27017   (service name from docker-compose.yml)
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=milena_petrova

# --- Public site origin ------------------------------------------------------
# Used for links in customer-facing email (e.g. the "book another slot" link).
# No trailing slash.
SITE_URL=https://milenapetrova.bg

# --- Required in production: CORS --------------------------------------------
# Comma-separated list of allowed browser origins. Defaults to "*", which is
# fine locally but must be narrowed before going live.
CORS_ORIGINS=http://localhost:3000

# --- Required for the admin dashboard ----------------------------------------
# Admin login is disabled (503) until ADMIN_PASSWORD_HASH is set.
# The hash is an unsalted SHA-256 of the password. Generate one with:
#   python3 -c "import hashlib,getpass;print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- Payments (Stripe) -------------------------------------------------------
# Without STRIPE_API_KEY the /api/payments endpoints return 503; the rest of
# the site keeps working. Use a test key (sk_test_...) outside production.
STRIPE_API_KEY=sk_test_replace_me
# Signing secret for the /api/payments/webhook/stripe endpoint, from the Stripe
# dashboard or `stripe listen`. Webhooks are rejected while this is empty,
# because an unverified payload must not be able to mark an order as paid.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Transactional email (Resend) --------------------------------------------
# Booking confirmation and cancellation emails. See memory/RESEND_EMAIL_SETUP.md
RESEND_API_KEY=re_replace_me
# Must be an address on a domain verified in Resend. The default
# onboarding@resend.dev only delivers to the account owner.
SENDER_EMAIL=noreply@milenapetrova.bg

# --- Google Calendar ---------------------------------------------------------
# OAuth client for slot lookup and event creation.
# See memory/GOOGLE_CALENDAR_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console exactly.
GOOGLE_REDIRECT_URI=http://localhost:8001/api/calendar/oauth/callback

# --- Meta / Facebook Conversions API -----------------------------------------
# Server-side conversion tracking. See FACEBOOK_TRACKING_INTEGRATION.md
# Tracking degrades to a no-op when these are unset.
META_PIXEL_ID=
META_ACCESS_TOKEN=
